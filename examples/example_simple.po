# Placeholders are ignored.
#, python-format
msgid "Welcome back, %(name)s!"
msgstr "Willkommen zurück, %(name)s!"

#, python-brace-format
msgid "Send an e-mail to {email}"
msgstr "Senden Sie eine E-Mail an {email}"

# Typographic punctuation is stripped.
msgid "He said: \"Goodbye…\""
msgstr "Er sagte: „Auf Wiedersehen…“"

# Plural forms are checked, both msgid_plural and msgstr[n].
#, c-format
msgid "%d file was deleted"
msgid_plural "%d files were deletd"
msgstr[0] "%d Datei wurde gelöscht"
msgstr[1] "%d Dateien wurden gelöshct"

